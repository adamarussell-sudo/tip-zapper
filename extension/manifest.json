{
  "manifest_version": 3,
  "name": "Tip Zapper",
  "version": "1.3.0",
  "description": "Sets the pre-filled grocery tip on Amazon checkout back to $0, and stops you before you order with a tip still on.",
  "homepage_url": "https://github.com/adamarussell-sudo/tip-zapper",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
